{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": "./",
    "paths": {
      "@ts-sm/shared": ["../../packages/shared/src/index.ts"],
      "@ts-sm/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src"]
}

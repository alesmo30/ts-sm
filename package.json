{
  "name": "ts-sm",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "postinstall": "pnpm --filter shared build",
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "docker:up": "docker compose up",
    "seed": "pnpm --filter api seed",
    "dataset:fetch": "test -d dataset-reto || git clone --depth 1 https://github.com/TechSphere2026/ParticipantArtifacts.git dataset-reto",
    "kb:ingest": "pnpm --filter api kb:ingest",
    "kb:translate": "pnpm --filter api kb:translate",
    "kb:dump": "pnpm --filter api kb:dump"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.66.0"
  }
}

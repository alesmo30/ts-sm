{
  "name": "ts-sm",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "docker:up": "docker compose up"
  },
  "devDependencies": {}
}

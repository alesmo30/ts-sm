# ── Base de datos ──────────────────────────────────────────────
# Usuario, password y nombre de la db de Postgres/pgvector.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tssm

# Puerto expuesto por el contenedor db en el host.
DB_PORT=5432

# Cadena de conexión completa que usa la API (Drizzle/pg).
# Dentro de docker compose el host es "db"; en local es "localhost".
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tssm

# ── API (NestJS) ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PORT=3000

# ── Web (Vite) ─────────────────────────────────────────────────
WEB_PORT=5173
VITE_API_URL=http://localhost:3000

# ── LLM (LlmPort — ver apps/api/src/modules/llm) ────────────────
# Proveedor activo: mock | anthropic | openai. mock no requiere ninguna key.
LLM_PROVIDER=mock
# Identificador del modelo. Sin default: obligatorio si LLM_PROVIDER != mock.
LLM_MODEL=
# Solo si LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Solo si LLM_PROVIDER=openai (o un gateway compatible, ver OPENAI_BASE_URL).
OPENAI_API_KEY=
# Host de la API compatible con OpenAI. Por defecto OpenAI; usar
# https://api.groq.com/openai/v1 para Groq u otro gateway compatible.
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Conocimiento / RAG (ver apps/api/src/modules/knowledge) ─────
# Carpeta local con los PDFs del corpus del reto (dataset-reto/dataset/textos
# tras correr `pnpm dataset:fetch`). La usan kb-ingest.ts y kb:ingest.
KNOWLEDGE_LOCAL_DIR=./dataset-reto/dataset/textos

# ── Voz (VoiceService — ver apps/api/src/modules/voice) ─────────
# Proveedor activo: off | deepgram | webspeech. off no requiere ninguna key
# y deja el micrófono deshabilitado (modo texto puro).
VOICE_PROVIDER=off
# Solo si VOICE_PROVIDER=deepgram.
DEEPGRAM_API_KEY=
# Modelo de STT (Nova-3) y de TTS (Aura-2, es-CO). Los defaults ya son estos
# valores si se dejan vacíos.
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-celeste-es

# ── Embeddings (EmbeddingClient — ver apps/api/src/modules/embeddings) ──
# Embeddings de Gemini/AI Studio, no un LLM generativo (zona gris de
# REGLAS.md). Compartido por el backstop de escalada y el filtro de
# relevancia de citas — sin GEMINI_API_KEY, ambos quedan desactivados
# (fail-open) y el sistema se comporta como antes de que existieran.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── Backstop de escalada (RedFlagDetectorService — ver
# apps/api/src/modules/escalation) ──────────────────────────────
# Similitud coseno mínima (0-1) contra las frases de alarma para disparar
# la escalada sin que el LLM haya emitido la marca. Calibrado contra
# gemini-embedding-001: por debajo de ~0.8 empiezan los falsos positivos
# con mensajes benignos (la similitud base entre frases médicas ya es alta).
ESCALATION_SIMILARITY_THRESHOLD=0.83

# ── Relevancia de citas (CitationRelevanceService — ver
# apps/api/src/modules/knowledge) ────────────────────────────────
# Similitud coseno mínima (0-1) entre la pregunta del paciente y el
# fragmento recuperado para mostrarlo como cita / usarlo para fundamentar
# la respuesta. El retrieval léxico (ts_rank) siempre trae top-K aunque
# solo coincida una palabra genérica ("control", "cita") — este filtro
# es lo que descarta esos falsos positivos antes de llegar al paciente.
CITATION_RELEVANCE_THRESHOLD=0.7

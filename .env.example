# ── Base de datos ──────────────────────────────────────────────
# Usuario, password y nombre de la db de Postgres/pgvector.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tssm

# Puerto expuesto por el contenedor db en el host.
DB_PORT=5432

# Cadena de conexión completa que usa la API (Drizzle/pg).
# Dentro de docker compose el host es "db"; en local es "localhost".
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tssm

# ── API (NestJS) ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PORT=3000

# ── Web (Vite) ─────────────────────────────────────────────────
WEB_PORT=5173
VITE_API_URL=http://localhost:3000

# ── LLM (LlmPort — ver apps/api/src/modules/llm) ────────────────
# Proveedor activo: mock | anthropic | openai. mock no requiere ninguna key.
LLM_PROVIDER=mock
# Identificador del modelo. Sin default: obligatorio si LLM_PROVIDER != mock.
LLM_MODEL=
# Solo si LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Solo si LLM_PROVIDER=openai (o un gateway compatible, ver OPENAI_BASE_URL).
OPENAI_API_KEY=
# Host de la API compatible con OpenAI. Por defecto OpenAI; usar
# https://api.groq.com/openai/v1 para Groq u otro gateway compatible.
OPENAI_BASE_URL=https://api.openai.com/v1

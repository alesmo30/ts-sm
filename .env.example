# ── Base de datos ──────────────────────────────────────────────
# Usuario, password y nombre de la db de Postgres/pgvector.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tssm

# Puerto expuesto por el contenedor db en el host.
DB_PORT=5432

# Cadena de conexión completa que usa la API (Drizzle/pg).
# Dentro de docker compose el host es "db"; en local es "localhost".
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tssm

# ── API (NestJS) ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PORT=3000

# ── Web (Vite) ─────────────────────────────────────────────────
WEB_PORT=5173
VITE_API_URL=http://localhost:3000

# ── LLM (contrato only en este spec — sin driver aún) ──────────
# Variables reservadas para cuando aterrice el driver de LlmPort.
# LLM_MODEL_PATH=
# LLM_API_KEY=
